  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "type": "string",
                "title": "Code"
              },
              "message": {
                "type": "string",
                "title": "Message"
              },
              "details": {
                "additionalProperties": true,
                "type": "object",
                "title": "Details"
              }
            },
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "title": "ErrorBody"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "error",
          "request_id"
        ],
        "title": "ErrorEnvelope"
      },
      "BootstrapIn": {
        "properties": {
          "bootstrap_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "title": "Bootstrap Token"
          },
          "user_key": {
            "type": "string",
            "pattern": "^[a-z]+:[A-Za-z0-9_.-]{1,64}$",
            "title": "User Key"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "title": "Display Name"
          }
        },
        "type": "object",
        "required": [
          "bootstrap_token",
          "user_key",
          "display_name"
        ],
        "title": "BootstrapIn"
      },
      "BootstrapOut": {
        "properties": {
          "user_key": {
            "type": "string",
            "title": "User Key"
          },
          "key_id": {
            "type": "string",
            "title": "Key Id"
          },
          "secret": {
            "type": "string",
            "title": "Secret"
          }
        },
