    "/api/projects/{project_id}/lineage/import/dbt-manifest": {
      "post": {
        "summary": "Import Dbt Manifest Lineage",
        "description": "dbt manifest 参考连接器：解析 nodes(resource_type=model)/sources/parent_map，按 4.3.1 合同生成模型级依赖边，复用 V0.9.2 导入事务与幂等语义（强制 scan_mode=incremental）。授权：editor+ 或 admin。错误码：422 DBT_MANIFEST_INVALID；422 DBT_MANIFEST_TOO_LARGE；422 DBT_NODES_UNMATCHED；409 LINEAGE_RUN_ID_REUSED；422 LINEAGE_IMPORT_VALIDATION_FAILED；404 PROJECT_NOT_FOUND；403。",
        "operationId": "import_dbt_manifest_lineage_api_projects__project_id__lineage_import_dbt_manifest_post",
        "parameters": [
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Project Id"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DbtManifestImport"
