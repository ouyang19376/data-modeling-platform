            "description": "Manifest Imported",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DbtManifestImportResult"
                }
              }
            }
          },
          "200": {
            "description": "Replayed (idempotent)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DbtManifestImportResult"
                }
              }
            }
          },
          "403": {
            "description": "Role insufficient",
