  "paths": {
    "/api/auth/bootstrap": {
      "post": {
        "summary": "Bootstrap First Admin",
        "description": "一次性引导：api_key 模式下 users 为空时，凭 BOOTSTRAP_TOKEN 创建首个管理员并返回其 API Key secret（仅此一次）。错误码：401 BOOTSTRAP_TOKEN_INVALID；409 BOOTSTRAP_NOT_CONFIGURED；409 BOOTSTRAP_ALREADY_DONE；422 REQUEST_VALIDATION_FAILED。",
        "operationId": "bootstrap_first_admin_api_auth_bootstrap_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BootstrapIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapOut"
                }
              }
            }
          },
          "401": {
            "description": "Bootstrap token invalid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Bootstrap not configured or already done",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
